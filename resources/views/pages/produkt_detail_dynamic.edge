<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ product.name }} – Mixcha</title>

  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/produkt_detail.css">
</head>

<body class="page">
@include('pages/headerfooter/header')

<main class="product-detail">
  <div class="product-detail__inner">
    <div class="product-detail__media">
      <img
        class="product-detail__img"
        src="{{ product.imageUrl ?? '/images/logo.png' }}"
        alt="{{ product.name }}"
      >
    </div>

    <section class="product-detail__content">

      <h1 class="product-detail__title">
        {{ product.name }}
      </h1>

      <p class="product-detail__text">
        {{ product.description ?? 'Wähle deine bevorzugten Extras und erstelle deine eigene Matcha-Mischung.' }}
      </p>

      <form class="product-detail__form" method="POST" action="/warenkorb/add">
        {{ csrfField() }}

        <input type="hidden" name="product_id" value="{{ product.id }}">
        <input type="hidden" name="name" value="{{ product.name }}">
        <input type="hidden" name="image_url" value="{{ product.imageUrl ?? '/images/logo.png' }}">

        <input type="hidden" id="unit_price" name="unit_price" value="0">
        <input type="hidden" id="variant_id" name="variant_id" value="">

        <!--Extras-->
        @if(product.extras && product.extras.length)
          <div class="form-group">
            <label class="form-label">Extras</label>

            <select class="form-select" id="extras_select">
              @each(e in product.extras)
                <option
                  value="{{ e.id }}"
                  data-price="{{ e.priceDelta ?? 0 }}"
                >
                  {{ e.name }}
                  @if(Number(e.priceDelta) > 0)
                    (+{{ Number(e.priceDelta).toFixed(2).replace('.', ',') }} €)
                  @endif
                </option>
              @endeach
            </select>
          </div>
        @endif

        <!--Varianten-->
        @if(product.variants && product.variants.length)
          <div class="form-group">
            <label class="form-label">Verpackungsgröße</label>

            <select class="form-select" id="variant_select">
              @each(v in product.variants)
                <option
                  value="{{ v.id }}"
                  data-price="{{ v.price }}"
                >
                  {{ v.size }} 
                </option>
              @endeach
            </select>
          </div>
        @endif

        <!--Preis-->
        <p class="product-detail__price">
          <span id="price_label">0,00</span> €
        </p>

        <button class="product-detail__btn" type="submit">
          In den Warenkorb
        </button>

      </form>
    </section>
  </div>
</main>

@include('pages/headerfooter/footer')

<!--Javascript-->
<script>
document.addEventListener("DOMContentLoaded", () => {

  const variantSelect = document.getElementById("variant_select");
  const extrasSelect  = document.getElementById("extras_select");

  const priceLabel    = document.getElementById("price_label");
  const unitPrice     = document.getElementById("unit_price");
  const variantId     = document.getElementById("variant_id");

  function format(num) {
    return Number(num).toFixed(2).replace(".", ",");
  }

  function updatePrice() {
    let variantPrice = 0;
    let extraPrice = 0;

    if (variantSelect) {
      const opt = variantSelect.options[variantSelect.selectedIndex];
      variantPrice = Number(opt.dataset.price || 0);
      variantId.value = opt.value;
    }

    if (extrasSelect) {
      const opt = extrasSelect.options[extrasSelect.selectedIndex];
      extraPrice = Number(opt.dataset.price || 0);
    }

    const total = variantPrice + extraPrice;

    unitPrice.value = total.toFixed(2);
    priceLabel.textContent = format(total);
  }

  if (variantSelect) variantSelect.addEventListener("change", updatePrice);
  if (extrasSelect) extrasSelect.addEventListener("change", updatePrice);

  updatePrice();
});
</script>

</body>
</html>