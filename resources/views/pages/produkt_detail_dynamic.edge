<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ product.name }} – Mixcha</title>

  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/produkt_detail.css">
</head>

<body class="page">
  @include('pages/headerfooter/header')

  <main class="product-detail">
    <div class="product-detail__inner">
      <div class="product-detail__media">
        <img class="product-detail__img"
             src="{{ product.imageUrl ?? '/images/logo.png' }}"
             alt="{{ product.name }}">
      </div>

      <section class="product-detail__content">
        <h1 class="product-detail__title">{{ product.name }}</h1>

        @if(product.description)
          <p class="product-detail__text">{{ product.description }}</p>
        @else
          <p class="product-detail__text">Produktbeschreibung folgt.</p>
        @endif

        <form class="product-detail__form" method="POST" action="/warenkorb/add">
          {{ csrfField() }}

          <input type="hidden" name="product_id" value="{{ product.id }}">
          <input type="hidden" name="name" value="{{ product.name }}">
          <input type="hidden" name="image_url" value="{{ product.imageUrl ?? '/images/logo.png' }}">

          <!-- ✅ wird durch Varianten/Extras gesetzt -->
          <input type="hidden" id="unit_price" name="unit_price" value="{{ product.basePrice }}">
          <input type="hidden" id="variant_id" name="variant_id" value="">

          <!-- ✅ OPTIONAL: Extras als Liste (werden als Array gepostet) -->
          @if(product.extras && product.extras.length)
            <div class="field" style="margin-top: 14px;">
              <label>Extras wählen</label>

              <div style="display:grid; gap:8px; margin-top:8px;">
                @each(e in product.extras)
                  <label style="display:flex; gap:10px; align-items:center;">
                    <input
                      type="checkbox"
                      class="extra_cb"
                      name="extras[]"
                      value="{{ e.id }}"
                      data-price="{{ e.price }}"
                    >
                    <span>
                      {{ e.name }}
                      @if(Number(e.price) > 0)
                        (+{{ Number(e.price).toFixed(2).replace('.', ',') }} €)
                      @endif
                    </span>
                  </label>
                @endeach
              </div>
            </div>
          @endif

          <!-- ✅ Varianten -->
          @if(product.variants && product.variants.length)
            <div class="field" style="margin-top: 14px;">
              <label for="variant_select">Variante wählen</label>

              <!-- WICHTIG: id muss zu JS passen -->
              <select id="variant_select" name="variant_select">
                @each(v in product.variants)
                  <option value="{{ v.id }}" data-price="{{ v.price }}">
                    {{ v.name }} – {{ Number(v.price).toFixed(2).replace('.', ',') }} €
                  </option>
                @endeach
              </select>
            </div>
          @endif

          <!-- ✅ Preisanzeige -->
          <p class="product-detail__price">
            <span id="price_label">{{ Number(product.basePrice).toFixed(2).replace('.', ',') }}</span> €
          </p>

          <button class="product-detail__btn" type="submit">
            In den Warenkorb
          </button>
        </form>

      </section>
    </div>
  </main>

  @include('pages/headerfooter/footer')

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const select = document.getElementById('variant_select')
      const priceLabel = document.getElementById('price_label')
      const unitPriceInput = document.getElementById('unit_price')
      const variantIdInput = document.getElementById('variant_id')

      const extraCheckboxes = Array.from(document.querySelectorAll('.extra_cb'))

      const formatPrice = (num) => {
        return Number(num).toFixed(2).replace('.', ',')
      }

      const getSelectedVariantPrice = () => {
        if (!select) return Number(unitPriceInput.value || 0)

        const option = select.options[select.selectedIndex]
        const variantId = option.value
        const variantPrice = Number(option.getAttribute('data-price') || 0)

        // Hidden Inputs für Warenkorb
        variantIdInput.value = variantId
        unitPriceInput.value = String(variantPrice)

        return variantPrice
      }

      const getExtrasTotal = () => {
        let total = 0
        for (const cb of extraCheckboxes) {
          if (cb.checked) total += Number(cb.getAttribute('data-price') || 0)
        }
        return total
      }

      const updatePrice = () => {
        const base = getSelectedVariantPrice()
        const extras = getExtrasTotal()
        const finalPrice = base + extras
        priceLabel.textContent = formatPrice(finalPrice)
      }

      // ✅ initial
      updatePrice()

      // ✅ events
      if (select) select.addEventListener('change', updatePrice)
      for (const cb of extraCheckboxes) cb.addEventListener('change', updatePrice)
    })
  </script>
</body>
</html>