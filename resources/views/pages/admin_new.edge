<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Produkt anlegen – Mixcha</title>

  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>

<body class="page">
  @include('pages/headerfooter/header')

  <main class="admin">
    <h1>Produkt anlegen</h1>
    <p class="admin_subtitle">Neues Produkt in die Datenbank speichern</p>

    <section class="admin_products">
      <h2>Neues Produkt</h2>

      @if(flashMessages.has('error'))
        <p style="color:#8a2d2d; font-weight:600;">
          {{ flashMessages.get('error') }}
        </p>
      @endif

      <form method="POST" action="/admin/produkte">
        {{ csrfField() }}

        <div class="field">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" required>
        </div>

        <div class="field">
          <label for="description">Beschreibung</label>
          <input id="description" name="description" type="text">
        </div>

        <div class="field">
          <label for="base_price">Basispreis</label>
          <input id="base_price" name="base_price" type="number" step="0.01" required>
        </div>

        <div class="field">
          <label for="image_url">Bild-URL</label>
          <input id="image_url" name="image_url" type="text" placeholder="/images/DeinBild.png">
        </div>

        <div class="field">
          <label for="category_id">Kategorie-ID</label>
          <input id="category_id" name="category_id" type="number" value="1" required>
        </div>

        <div class="admin_actions">
          <button class="admin_btn" type="submit">Speichern</button>
          <a class="admin_btn admin_btn--secondary" href="/admin">Abbrechen</a>
        </div>
      </form>
    </section>
  </main>

  @include('pages/headerfooter/footer')
</body>
</html>