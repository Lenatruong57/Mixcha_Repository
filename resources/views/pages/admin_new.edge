<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Produkt anlegen – Mixcha</title>

  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>

<body class="page">
  @include('pages/headerfooter/header')

  <main class="admin">
    <h1>Produkt anlegen</h1>
    <p class="admin_subtitle">Neues Produkt in die Datenbank speichern</p>

    <section class="admin_products">
      <h2>Neues Produkt</h2>

      <form method="POST" action="/admin/produkte">
        {{ csrfField() }}

        <div class="field">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" required value="{{ old('name') ?? '' }}">
        </div>

        <div class="field">
          <label for="description">Beschreibung</label>
          <input id="description" name="description" type="text" value="{{ old('description') ?? '' }}">
        </div>

        <div class="field">
          <label for="base_price">Basispreis (optional)</label>
          <input
            id="base_price"
            name="base_price"
            type="number"
            step="0.01"
            placeholder="z.B. 19.90"
            value="{{ old('base_price') ?? '' }}"
          >
          <small style="opacity:.7; display:block; margin-top:6px;">
            Hinweis: Wenn ihr Varianten nutzt, kannst du den Basispreis leer lassen oder nur als Info verwenden.
          </small>
        </div>

        <div class="field">
          <label for="image_url">Bild-URL</label>
          <input
            id="image_url"
            name="image_url"
            type="text"
            placeholder="/images/DeinBild.png"
            value="{{ old('image_url') ?? '' }}"
          >
        </div>

        <div class="field">
          <label for="category_id">Kategorie-ID</label>
          <input
            id="category_id"
            name="category_id"
            type="number"
            value="{{ old('category_id') ?? '1' }}"
            required
          >
        </div>

        <hr style="margin:24px 0; opacity:.2;">

        <h3 style="margin:0 0 10px;">Varianten (3 Größen)</h3>
        <p style="margin:0 0 16px; opacity:.75;">
          Bitte alle 3 Varianten ausfüllen (Größe + Preis).
        </p>

        {{-- Variante 1 --}}
        <div class="field">
          <label for="v1_name">Variante 1 – Größe</label>
          <input
            id="v1_name"
            name="variants[0][name]"
            type="text"
            placeholder="z.B. Small (30g)"
            required
            value="{{ old('variants[0][name]') ?? '' }}"
          >
        </div>

        <div class="field">
          <label for="v1_price">Variante 1 – Preis (€)</label>
          <input
            id="v1_price"
            name="variants[0][price]"
            type="number"
            step="0.01"
            placeholder="z.B. 9.90"
            required
            value="{{ old('variants[0][price]') ?? '' }}"
          >
        </div>

        {{-- Variante 2 --}}
        <div class="field">
          <label for="v2_name">Variante 2 – Größe</label>
          <input
            id="v2_name"
            name="variants[1][name]"
            type="text"
            placeholder="z.B. Medium (50g)"
            required
            value="{{ old('variants[1][name]') ?? '' }}"
          >
        </div>

        <div class="field">
          <label for="v2_price">Variante 2 – Preis (€)</label>
          <input
            id="v2_price"
            name="variants[1][price]"
            type="number"
            step="0.01"
            placeholder="z.B. 14.90"
            required
            value="{{ old('variants[1][price]') ?? '' }}"
          >
        </div>

        {{-- Variante 3 --}}
        <div class="field">
          <label for="v3_name">Variante 3 – Größe</label>
          <input
            id="v3_name"
            name="variants[2][name]"
            type="text"
            placeholder="z.B. Large (100g)"
            required
            value="{{ old('variants[2][name]') ?? '' }}"
          >
        </div>

        <div class="field">
          <label for="v3_price">Variante 3 – Preis (€)</label>
          <input
            id="v3_price"
            name="variants[2][price]"
            type="number"
            step="0.01"
            placeholder="z.B. 24.90"
            required
            value="{{ old('variants[2][price]') ?? '' }}"
          >
        </div>

        <div class="admin_actions">
          <button class="admin_btn" type="submit">Speichern</button>
          <a class="admin_btn admin_btn--secondary" href="/admin">Abbrechen</a>
        </div>

        {{-- Flash Messages: unter dem Button --}}
        @if(flashMessages.has('error'))
          <p class="auth__msg auth__msg--error" style="margin: 14px 0 0;">
            {{ flashMessages.get('error') }}
          </p>
        @endif

        @if(flashMessages.has('success'))
          <p class="auth__msg auth__msg--success" style="margin: 14px 0 0;">
            {{ flashMessages.get('success') }}
          </p>
        @endif
      </form>
    </section>
  </main>

  @include('pages/headerfooter/footer')
</body>
</html>