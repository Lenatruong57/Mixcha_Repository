<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Produkt anlegen – Mixcha</title>

  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>

<body class="page">
  @include('pages/headerfooter/header')

  <main class="admin">
    <h1>Produkt anlegen</h1>
    <p class="admin_subtitle">Neues Produkt in die Datenbank speichern</p>

    <section class="admin_products">
      <h2>Neues Produkt</h2>

      @if(flashMessages.has('error'))
        <p style="color:#8a2d2d; font-weight:600;">
          {{ flashMessages.get('error') }}
        </p>
      @endif

      <form method="POST" action="/admin/produkte">
        {{ csrfField() }}

        <div class="field">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" required value="">
        </div>

        <div class="field">
          <label for="description">Beschreibung</label>
          <input id="description" name="description" type="text" value="">
        </div>

        <div class="field">
          <label for="base_price">Basispreis (optional)</label>
          <input id="base_price" name="base_price" type="number" step="0.01" value="">
          <small style="display:block; margin-top:6px; opacity:.75;">
            Hinweis: Wenn ihr Varianten nutzt, kannst du den Basispreis leer lassen oder nur als Info verwenden.
          </small>
        </div>

        <div class="field">
          <label for="image_url">Bild-URL</label>
          <input id="image_url" name="image_url" type="text" value="">
        </div>

        <div class="field">
          <label for="category_id">Kategorie-ID</label>
          <input id="category_id" name="category_id" type="number" required value="1">
        </div>

        <hr style="margin: 18px 0; opacity: .2;">

        <h3 style="margin: 0 0 10px;">Varianten (3 Größen)</h3>
        <p style="margin: 0 0 14px; opacity: .75;">
          Bitte alle 3 Varianten ausfüllen (Größe + Preis).
        </p>

        <div class="field">
          <label>Variante 1 – Größe</label>
          <input name="variants[0][size]" type="text" required placeholder="z.B. 30g">
        </div>
        <div class="field">
          <label>Variante 1 – Preis (€)</label>
          <input name="variants[0][price]" type="number" step="0.01" required placeholder="z.B. 9.90">
        </div>

        <div class="field">
          <label>Variante 2 – Größe</label>
          <input name="variants[1][size]" type="text" required placeholder="z.B. 70g">
        </div>
        <div class="field">
          <label>Variante 2 – Preis (€)</label>
          <input name="variants[1][price]" type="number" step="0.01" required placeholder="z.B. 14.90">
        </div>

        <div class="field">
          <label>Variante 3 – Größe</label>
          <input name="variants[2][size]" type="text" required placeholder="z.B. 100g">
        </div>
        <div class="field">
          <label>Variante 3 – Preis (€)</label>
          <input name="variants[2][price]" type="number" step="0.01" required placeholder="z.B. 24.90">
        </div>

        <hr style="margin: 18px 0; opacity: .2;">

        <h3 style="margin: 0 0 10px;">Extras (genau 4)</h3>
        <p style="margin: 0 0 14px; opacity: .75;">
          Jeder Extra braucht nur einen Namen (Geschmack). Kein Aufpreis.
        </p>

        <div class="field">
          <label>Extra 1 – Name</label>
          <input name="extras[0][name]" type="text" required placeholder="z.B. Vanille">
        </div>

        <div class="field">
          <label>Extra 2 – Name</label>
          <input name="extras[1][name]" type="text" required placeholder="z.B. Kokos">
        </div>

        <div class="field">
          <label>Extra 3 – Name</label>
          <input name="extras[2][name]" type="text" required placeholder="z.B. Zimt">
        </div>

        <div class="field">
          <label>Extra 4 – Name</label>
          <input name="extras[3][name]" type="text" required placeholder="z.B. Erdbeere">
        </div>

        <div class="admin_actions">
          <button class="admin_btn" type="submit">Speichern</button>
          <a class="admin_btn admin_btn--secondary" href="/admin">Abbrechen</a>
        </div>
      </form>
    </section>
  </main>

  @include('pages/headerfooter/footer')
</body>
</html>