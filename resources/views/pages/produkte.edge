<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Unsere Produkte – Mixcha</title>

  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/produkte.css">
</head>

<body class="page">
  @include('pages/headerfooter/header')

  <main class="products">
    <h1 class="products__title">Unsere Produkte</h1>
    <p class="products__subtitle">Entdecke deinen perfekten Matcha und mixe ihn nach deinem Geschmack.</p>

    <section class="products__grid">
      @if(!products || products.length === 0)
        <p>Keine Produkte vorhanden.</p>
      @else
        @each(product in products)
          <article class="product-card">
            <a class="product-card__link"
               href="/produkte/{{ product.id }}"
               aria-label="{{ product.name }} öffnen">
              <div class="product-card__media">
                <img
                  class="product-card__img {{ product.id === 2 ? 'product-card__img--ceremonial' : '' }}"
                  src="{{ product.imageUrl ?? '/images/logo.png' }}"
                  alt="{{ product.name }}">
              </div>
            </a>

            <h2 class="product-card__name">
              @if(product.id === 1)
                Mix your Premium Matcha
              @elseif(product.id === 2)
                Mix your Ceremonial Matcha
              @else
                {{ product.name }}
              @endif
            </h2>

            <p class="product-card__price">
              ab {{ Number(product.basePrice).toFixed(2).replace('.', ',') }} €
            </p>

            <a class="product-card__btn" href="/produkte/{{ product.id }}">
              @if(product.id === 1 || product.id === 2)
                Mix now
              @else
                Buy now
              @endif
            </a>
          </article>
        @endeach
      @endif
    </section>
  </main>

  @include('pages/headerfooter/footer')
</body>
</html>