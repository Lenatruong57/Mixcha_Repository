<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Premium Matcha – Mixcha</title>

  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/produkt_detail.css">
</head>

<body class="page">
  @include('pages/headerfooter/header')

  <main class="product-detail">
    <div class="product-detail__inner">
      <div class="product-detail__media">
        <img class="product-detail__img" src="/images/MixchaPremium.png" alt="Mixcha Premium Matcha">
      </div>

      <section class="product-detail__content">
        <h1 class="product-detail__title">Premium Matcha</h1>
        <p class="product-detail__text">Wähle deine bevorzugten Extras und erstelle deine eigene Matcha-Mischung.</p>

        <form class="product-detail__form" method="post" action="/warenkorb/add">
          {{ csrfField() }}

        <input type="hidden" name="product_id" value="premium">
        <input type="hidden" name="name" value="Premium Matcha">
        <input type="hidden" name="base_price" value="19.90">
        <input type="hidden" name="image_url" value="/images/MixchaPremium.png">
          <!-- wichtig: wird per JS aktualisiert -->
          <input type="hidden" id="unitPriceInput" name="unit_price" value="19.90">

          <div class="form-group">
            <label class="form-label" for="extras">Extras</label>
            <select class="form-select" id="extras" name="extras">
              <option value="Vanille">Vanille</option>
              <option value="Kokos">Kokos</option>
              <option value="Zimt">Zimt</option>
              <option value="Kollagen">Veganes Kollagenpulver</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="size">Verpackungsgröße</label>
            <select class="form-select" id="size" name="size">
              <option value="30gr">30gr</option>
              <option value="70gr">70gr</option>
              <option value="100gr">100gr</option>
            </select>
          </div>

          <p class="product-detail__price"><span id="priceValue">19,90</span> €</p>

          <button class="product-detail__btn" type="submit">In den Warenkorb</button>
        </form>
      </section>
    </div>
  </main>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const prices = {
        "30": 19.90,
        "70": 39.90,
        "100": 59.90
      };

      const sizeSelect = document.getElementById("size");
      const priceValue = document.getElementById("priceValue");
      const unitPriceInput = document.getElementById("unitPriceInput");

      if (!sizeSelect || !priceValue || !unitPriceInput) return;

      const fmt = (n) => n.toFixed(2).replace(".", ",");

      const updatePrice = () => {
        const p = prices[sizeSelect.value] ?? 19.90;
        priceValue.textContent = fmt(p);
        unitPriceInput.value = String(p);
      };

      updatePrice();
      sizeSelect.addEventListener("change", updatePrice);
    });
  </script>

  @include('pages/headerfooter/footer')
</body>
</html>