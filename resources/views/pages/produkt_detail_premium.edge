<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>Premium Matcha – Mixcha</title>

  <!-- Globales Styling -->
  <link rel="stylesheet" href="/css/main.css" />
  <!-- Seiten-spezifisches Styling -->
  <link rel="stylesheet" href="/css/produkt_detail_premium.css" />
</head>

<body class="page">

  @include('pages/headerfooter/header')

  <main class="product-detail">
    <div class="product-detail__inner">

      <!-- Bild -->
      <div class="product-detail__media">
        <img
          class="product-detail__img"
          src="/images/MixchaPremium.png"
          alt="Mixcha Premium Matcha"
        />
      </div>

      <!-- Inhalt -->
      <section class="product-detail__content">
        <h1 class="product-detail__title">Premium Matcha</h1>

        <p class="product-detail__text">
          Wähle deine bevorzugten Extras und erstelle deine eigene Matcha-Mischung.
        </p>

        <form class="product-detail__form" method="post" action="">
          <!-- Extras -->
          <div class="form-group">
            <label class="form-label" for="extras">Extras</label>
            <select class="form-select" id="extras" name="extras">
              <option value="vanille">Vanille</option>
              <option value="kokos">Kokos</option>
              <option value="zimt">Zimt</option>
              <option value="kollagen">Veganes Kollagenpulver</option>
            </select>
          </div>

          <!-- Verpackungsgröße -->
          <div class="form-group">
            <label class="form-label" for="size">Verpackungsgröße</label>
            <select class="form-select" id="size" name="size">
              <option value="30">30gr</option>
              <option value="70">70gr</option>
              <option value="100">100gr</option>
            </select>
          </div>


          <!-- Preis -->
          <p class="product-detail__price">
            <span id="priceValue" data-base="19,90">19,90</span> €
          </p>

          <button class="product-detail__btn" type="button">
            Mix your Matcha
          </button>
        </form>
      </section>
    </div>
  </main>

  @include('pages/headerfooter/footer')

  <!-- Preis-Logik -->
  <script>
    (function () {
      const prices = {
        "30": "19,90",
        "70": "39,90",
        "100": "59,90",
      };

      const sizeSelect = document.getElementById("size");
      const priceValue = document.getElementById("priceValue");

      if (!sizeSelect || !priceValue) return;

      function updatePrice() {
        const selected = sizeSelect.value;
        priceValue.textContent =
          prices[selected] || priceValue.dataset.base || "19,90";
      }

      sizeSelect.addEventListener("change", updatePrice);
      updatePrice();
    })();
  </script>

</body>
</html>