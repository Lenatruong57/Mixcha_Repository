<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Warenkorb – Mixcha</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/warenkorb.css">
</head>

<body class="page">
  @include('pages/headerfooter/header')

  <main class="cart">
    <div class="cart__inner">
      <div class="cart__top">
        <h1 class="cart__title">Dein Warenkorb</h1>
        <a class="cart__continue" href="/produkte">Weiter shoppen</a>
      </div>

      @if(cart.length === 0)
        <p class="cart__empty">Dein Warenkorb ist leer.</p>
      @else
        <div class="cart__table">
          @each(item in cart)
            <div class="cart__row">
              <div class="cart__product">
                <img class="cart__img" src="{{ item.imageUrl }}" alt="{{ item.name }}">
                <div class="cart__info">
                  <div class="cart__name">{{ item.name }}</div>
                  <div class="cart__meta">
                    @if(item.size) Größe: {{ item.size }}gr · @endif
                    @if(item.extras) Extras: {{ item.extras }} · @endif
                    @if(item.color) Farbe: {{ item.color }} · @endif
                    @if(item.engraving) Gravur: {{ item.engraving }} @endif
                  </div>
                </div>
              </div>

              <div class="cart__price">{{ item.unitPrice.toFixed(2).replace(".", ",") }} €</div>

              <div class="cart__qty">
                <form method="POST" action="/warenkorb/update">
                  @csrf()
                  <input type="hidden" name="key" value="{{ item.key }}">
                  <input type="number" min="1" name="quantity" value="{{ item.quantity }}" />
                  <button type="submit">OK</button>
                </form>
              </div>

              <div class="cart__total">
                {{ (item.unitPrice * item.quantity).toFixed(2).replace(".", ",") }} €
              </div>

              <div class="cart__remove">
                <form method="POST" action="/warenkorb/remove">
                  @csrf()
                  <input type="hidden" name="key" value="{{ item.key }}">
                  <button type="submit">✕</button>
                </form>
              </div>
            </div>
          @endeach
        </div>

        <div class="cart__summary">
          <div class="cart__sumline">
            <span>Zwischensumme</span>
            <strong>{{ subtotal.toFixed(2).replace(".", ",") }} €</strong>
          </div>

          <form method="POST" action="/warenkorb/clear">
            @csrf()
            <button type="submit">Warenkorb leeren</button>
          </form>
        </div>
      @endif
    </div>
  </main>

  @include('pages/headerfooter/footer')
</body>
</html>