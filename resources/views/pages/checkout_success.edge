<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Bestellung erfolgreich – Mixcha</title>

  <link rel="stylesheet" href="/css/main.css" />
  <link rel="stylesheet" href="/css/checkout_success.css" />
</head>

<body>
  @include('pages/headerfooter/header')

  <main class="success">
    <div class="success-card">
      <h1>Vielen Dank für deine Bestellung!</h1>

      <div class="summary">
        <h2>Zusammenfassung</h2>

        <div class="summary-table">
          <div class="summary-head">
            <div>Produkt</div>
            <div class="center">Anzahl</div>
            <div class="right">Preis</div>
          </div>

          @if((items || []).length === 0)
            <div class="summary-row">
              <div>Keine Positionen gefunden.</div>
              <div class="center">—</div>
              <div class="right">—</div>
            </div>
          @else
            @each(item in items)
              <div class="summary-row">
                <div class="prod">
                  @if(item.imageUrl)
                    <img class="prod-img" src="{{ item.imageUrl }}" alt="{{ item.name }}" />
                  @endif
                  <span>{{ item.name }}</span>
                </div>

                <div class="center">{{ item.quantity }}</div>

                <div class="right">
                  {{ Number(item.price).toFixed(2).replace('.', ',') }} €
                </div>
              </div>
            @endeach
          @endif
        </div>

        <div class="summary-bottom">
          <div class="address">
            <h3>Wir liefern an:</h3>

            @if(customer)
              <p>
                {{ customer.first_name ?? '' }} {{ customer.last_name ?? '' }}<br />
                {{ customer.street ?? '' }} {{ customer.house_number ?? '' }}<br />
                {{ customer.postal_code ?? '' }} {{ customer.city ?? '' }}
              </p>
            @else
              <p>—</p>
            @endif
          </div>

          <div class="total">
            <div class="label">Gesamtsumme</div>
            <div class="value">{{ Number(totalSum ?? 0).toFixed(2).replace('.', ',') }} €</div>
            <div class="small">inkl. Versand {{ Number(shippingSum ?? 0).toFixed(2).replace('.', ',') }} €</div>
          </div>
        </div>

        <div class="success-actions">
          <a class="btn-primary" href="/produkte">Hier weiter shoppen</a>
          <a class="btn-secondary" href="/">Zurück zur Startseite</a>
        </div>
      </div>
        <div class="success-image">
          <img src="/images/logo2.png" alt="Mixcha Logo"/>
        </div>
    </div>
  </main>

  @include('pages/headerfooter/footer')
</body>
</html>