<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Produkt bearbeiten – Mixcha</title>

  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>

<body class="page">
  @include('pages/headerfooter/header')

  <main class="admin">
    <h1>Produkt bearbeiten</h1>
    <p class="admin_subtitle">Änderungen speichern</p>

    <section class="admin_products">
      <h2>{{ product.name }}</h2>

      @if(flashMessages.has('error'))
        <p style="color:#8a2d2d; font-weight:600;">
          {{ flashMessages.get('error') }}
        </p>
      @endif

      <form method="POST" action="/admin/produkte/{{ product.id }}">
        {{ csrfField() }}

        <!-- Grunddaten -->
        <div class="field">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" required value="{{ product.name }}">
        </div>

        <div class="field">
          <label for="description">Beschreibung</label>
          <input id="description" name="description" type="text" value="{{ product.description ?? '' }}">
        </div>

        <div class="field">
          <label for="base_price">Basispreis</label>
          <input id="base_price" name="base_price" type="number" step="0.01" required value="{{ product.basePrice }}">
        </div>

        <div class="field">
          <label for="image_url">Bild-URL</label>
          <input id="image_url" name="image_url" type="text" value="{{ product.imageUrl ?? '' }}">
        </div>

        <div class="field">
          <label for="category_id">Kategorie-ID</label>
          <input id="category_id" name="category_id" type="number" required value="{{ product.categoryId }}">
        </div>

        <hr style="margin: 18px 0; opacity: .2;">

        <!-- Varianten -->
        <h3 style="margin: 0 0 10px;">Varianten (genau 3)</h3>
        <p style="margin: 0 0 14px; opacity: .75;">
          Jede Variante braucht Größe + Preis. (Wird im Warenkorb verwendet.)
        </p>

        <!-- Variante 1 -->
        <div class="field">
          <label for="v1_size">Variante 1 – Größe</label>
          <input
            id="v1_size"
            name="variants[0][size]"
            type="text"
            required
            value="{{ product.variants && product.variants[0] ? product.variants[0].size : '' }}"
          >
        </div>

        <div class="field">
          <label for="v1_price">Variante 1 – Preis</label>
          <input
            id="v1_price"
            name="variants[0][price]"
            type="number"
            step="0.01"
            required
            value="{{ product.variants && product.variants[0] ? product.variants[0].price : '' }}"
          >
        </div>

        <!-- Variante 2 -->
        <div class="field">
          <label for="v2_size">Variante 2 – Größe</label>
          <input
            id="v2_size"
            name="variants[1][size]"
            type="text"
            required
            value="{{ product.variants && product.variants[1] ? product.variants[1].size : '' }}"
          >
        </div>

        <div class="field">
          <label for="v2_price">Variante 2 – Preis</label>
          <input
            id="v2_price"
            name="variants[1][price]"
            type="number"
            step="0.01"
            required
            value="{{ product.variants && product.variants[1] ? product.variants[1].price : '' }}"
          >
        </div>

        <!-- Variante 3 -->
        <div class="field">
          <label for="v3_size">Variante 3 – Größe</label>
          <input
            id="v3_size"
            name="variants[2][size]"
            type="text"
            required
            value="{{ product.variants && product.variants[2] ? product.variants[2].size : '' }}"
          >
        </div>

        <div class="field">
          <label for="v3_price">Variante 3 – Preis</label>
          <input
            id="v3_price"
            name="variants[2][price]"
            type="number"
            step="0.01"
            required
            value="{{ product.variants && product.variants[2] ? product.variants[2].price : '' }}"
          >
        </div>

        <hr style="margin: 18px 0; opacity: .2;">

        <!-- Extras -->
        <h3 style="margin: 0 0 10px;">Extras (genau 4)</h3>
        <p style="margin: 0 0 14px; opacity: .75;">
          Jeder Extra braucht nur einen Namen (Geschmack). Kein Aufpreis.
        </p>

        <div class="field">
          <label>Extra 1 – Name</label>
          <input
            name="extras[0][name]"
            type="text"
            required
            value="{{ product.extras && product.extras[0] ? product.extras[0].name : '' }}"
          >
        </div>

        <div class="field">
          <label>Extra 2 – Name</label>
          <input
            name="extras[1][name]"
            type="text"
            required
            value="{{ product.extras && product.extras[1] ? product.extras[1].name : '' }}"
          >
        </div>

        <div class="field">
          <label>Extra 3 – Name</label>
          <input
            name="extras[2][name]"
            type="text"
            required
            value="{{ product.extras && product.extras[2] ? product.extras[2].name : '' }}"
          >
        </div>

        <div class="field">
          <label>Extra 4 – Name</label>
          <input
            name="extras[3][name]"
            type="text"
            required
            value="{{ product.extras && product.extras[3] ? product.extras[3].name : '' }}"
          >
        </div>

        <div class="admin_actions">
          <button class="admin_btn" type="submit">Speichern</button>
          <a class="admin_btn admin_btn--secondary" href="/admin">Abbrechen</a>
        </div>
      </form>
    </section>
  </main>

  @include('pages/headerfooter/footer')
</body>
</html>