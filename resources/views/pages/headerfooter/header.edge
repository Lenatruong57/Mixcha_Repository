        <form method="POST" action="/logout" class="nav-icon-form">
          {{ csrfField() }}
          <button type="submit" class="nav-icon-btn" aria-label="Logout" title="Logout">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22"
              viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
              <path d="M16 17l5-5-5-5"/>
              <path d="M21 12H9"/>
            </svg>
          </button>
        </form>

      {{-- =========================
           KUNDE eingeloggt
         ========================= --}}
      @elseif(session.get('customerId'))
        <a href="/profil" class="nav-icon" aria-label="Profil">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
            viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21a8 8 0 0 0-16 0"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </a>

        <form method="POST" action="/logout" class="nav-icon-form">
          {{ csrfField() }}
          <button type="submit" class="nav-icon-btn" aria-label="Logout" title="Logout">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22"
              viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
              <path d="M16 17l5-5-5-5"/>
              <path d="M21 12H9"/>
            </svg>
          </button>
        </form>

      {{-- =========================
           Niemand eingeloggt
         ========================= --}}
      @else
        <a href="/login" class="nav-icon" aria-label="Login">
