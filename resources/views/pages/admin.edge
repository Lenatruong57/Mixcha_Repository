<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin – Mixcha</title>

  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>

<body class="page">
  @include('pages/headerfooter/header')

  <main class="admin">
    <h1>Admin-Bereich</h1>
    <p class="admin_subtitle">Produkte aus der Datenbank</p>

    <!-- Aktionen (Lena) -->
    <div class="admin_actions">
      <a href="/admin/produkte/new" class="admin_btn">
        + Produkt anlegen
      </a>
    </div>

    <!-- Produktliste (Lena) -->
    <section class="admin_products">
      <h2>Produkte</h2>

      @if(products.length === 0)
        <p>Keine Produkte vorhanden.</p>
      @else
        <ul>
          @each(product in products)
            <li>
              <strong>{{ product.name }}</strong><br>
              Preis: {{ product.basePrice }} €<br>
              Kategorie-ID: {{ product.categoryId }}

              <div class="admin_item_actions">
                <a href="/admin/produkte/{{ product.id }}/edit"
                   class="admin_btn admin_btn--secondary">
                  Bearbeiten
                </a>

                <form method="POST"
                      action="/admin/produkte/{{ product.id }}/delete"
                      class="admin_delete_form">
                  {{ csrfField() }}
                  <button type="submit"
                          class="admin_btn admin_btn--danger"
                          onclick="return confirm('Produkt wirklich löschen?')">
                    Löschen
                  </button>
                </form>
              </div>
            </li>
          @endeach
        </ul>
      @endif
    </section>
  </main>

  @include('pages/headerfooter/footer')
 
</body>
</html>