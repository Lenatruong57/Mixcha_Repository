<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <title>Admin – Mixcha</title>

  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/admin.css">
  
</head>
<body>

  {{-- Header --}}
  @include('pages/headerfooter/header')

  <main class="admin">

  <p class="admin_subtitle">
    Willkommen im Händlerbereich.<br>
    Hier kannst du Produkte verwalten.
  </p>

  <section class="admin_actions">
    <a href="/admin/produkte" class="admin_btn">Produkte verwalten</a>
    <a href="/admin/produkte/new" class="admin_btn admin_btn--secondary">Produkt anlegen</a>
  </section>

  <section class="admin_products">
    <h2>Produkte</h2>

    @if(products.length === 0)
      <p>Noch keine Produkte vorhanden.</p>
    @else
      <ul>
        @each(product in products)
          <li>
            {{ product.id }} – {{ product.name ?? 'kein Name' }}
          </li>
        @endeach
      </ul>
    @endif
  </section>

  <section class="admin_info">
    <h2>Hinweise</h2>
    <ul>
      <li>Nur eingeloggte Händler haben Zugriff</li>
      <li>Produkte können angelegt, bearbeitet und gelöscht werden</li>
      <li>Bestellungen sind für Kunden reserviert</li>
    </ul>
  </section>

  <form method="POST" action="/haendler-logout" class="admin_logout">
    {{ csrfField() }}
    <button type="submit" class="admin_btn admin_btn--logout">
      Logout Händler
    </button>
  </form>

</main>

  {{-- Footer --}}
  @include('pages/headerfooter/footer')

</body>
</html>