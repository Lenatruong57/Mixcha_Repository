<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Home – Mixcha</title>

  <link rel="icon" href="/images/favicon.png">

  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/home.css">

  <!-- DAMIT die Produkte auf Home exakt wie auf /produkte aussehen -->
  <link rel="stylesheet" href="/css/produkte.css">
</head>

<body>
  @include('pages/headerfooter/header')

  <main>

    <section class="hero">
      <video class="hero-video" autoplay muted loop playsinline>
        <source src="/videos/matchavideo3.mp4" type="video/mp4">
      </video>

      <div class="hero-text">
      <div class="hero-copy">
        <h1>Mix your own Matcha.</h1>
      <p>Kreiere deine persönliche Mischung mit nur wenigen Klicks.</p>
      </div>

      <a href="/produkte" class="btn-main hero-btn">Jetzt starten</a>
      </div>
    </section>


    <!-- PRODUKTE: dynamisch aus DB, aber exakt gleiche Klassen -->
    <section class="products home-products">
      <div class="home-wrap">
        <h2 class="products__title">Unsere Produkte</h2>
        <p class="products__subtitle">Entdecke deinen perfekten Matcha und mixe ihn nach deinem Geschmack.</p>

        <section class="products__grid">
          @if(!products || products.length === 0)
            <p>Keine Produkte vorhanden.</p>
          @else
            @each(product in products)
              <article class="product-card">
                <a class="product-card__link"
                   href="/produkte/{{ product.id }}"
                   aria-label="{{ product.name }} öffnen">
                  <div class="product-card__media">
                    <img
                      class="product-card__img {{ product.id === 2 ? 'product-card__img--ceremonial' : '' }}"
                      src="{{ product.imageUrl ?? '/images/logo.png' }}"
                      alt="{{ product.name }}">
                  </div>
                </a>

                <h3 class="product-card__name">
                  @if(product.id === 1)
                    Mix your Premium Matcha
                  @elseif(product.id === 2)
                    Mix your Ceremonial Matcha
                  @else
                    {{ product.name }}
                  @endif
                </h3>

                <p class="product-card__price">
                  ab {{ Number(product.basePrice).toFixed(2).replace('.', ',') }} €
                </p>

                <a class="product-card__btn" href="/produkte/{{ product.id }}">
                  @if(product.id === 1 || product.id === 2)
                    Mix now
                  @else
                    Buy now
                  @endif
                </a>
              </article>
            @endeach
          @endif
        </section>
      </div>
    </section>

    <section class="home-why">
      <div class="home-wrap">
        <h2 class="home-why__title">Warum mixcha?</h2>

        <div class="home-why__grid">
          <article class="home-why__card">
            <img class="home-why__icon" src="/images/bestermatcha.png" alt="Beste Qualität">
            <h3 class="home-why__cardTitle">Beste Qualität</h3>
            <p class="home-why__text">
              Wir setzen auf hochwertigen Matcha und sorgfältige Auswahl – für Geschmack, der wirklich überzeugt.
            </p>
          </article>

          <article class="home-why__card">
            <img class="home-why__icon" src="/images/vegan.png" alt="Vegan">
            <h3 class="home-why__cardTitle">Vegan</h3>
            <p class="home-why__text">
              Unsere Produkte sind komplett vegan – ohne Kompromisse bei Genuss oder Qualität.
            </p>
          </article>

          <article class="home-why__card">
            <img class="home-why__icon" src="/images/geschmack.png" alt="Viele Variationen">
            <h3 class="home-why__cardTitle">Viele Variationen</h3>
            <p class="home-why__text">
              Von klassisch bis kreativ: Du mixst deinen Matcha so, wie er zu dir passt – das macht uns einzigartig.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="home-faq">
      <div class="home-wrap">
        <h2 class="home-faq__title">FAQ</h2>
        <p class="home-faq__subtitle">Kurz erklärt – die wichtigsten Fragen zu Matcha.</p>
        
        <div class="faq-grid">

          <div class="faq-col">
            <details class="faq-item" open>
              <summary class="faq-question">Was macht Matcha so besonders?</summary>
              <div class="faq-answer">
                Matcha ist fein gemahlenes Grünteepulver – du konsumierst das ganze Blatt und damit besonders viele Nährstoffe.
              </div>
            </details>

            <details class="faq-item">
              <summary class="faq-question">Welcher Matcha eignet sich für Latte?</summary>
              <div class="faq-answer">
                Für Latte eignet sich Premium Matcha, da er kräftiger im Geschmack ist und gut mit Milch harmoniert.
              </div>
            </details>

            <details class="faq-item">
              <summary class="faq-question">Wie bereite ich Matcha richtig zu?</summary>
              <div class="faq-answer">
                Matcha sieben, mit ca. 70–80 °C warmem Wasser anrühren und mit dem Chasen schaumig schlagen.
              </div>
            </details>
          </div>

          <div class="faq-col">
            <details class="faq-item">
              <summary class="faq-question">Ist Matcha wirklich vegan?</summary>
              <div class="faq-answer">
                Ja! Matcha besteht zu 100 % aus gemahlenem Grüntee und ist von Natur aus vegan.
              </div>
            </details>

            <details class="faq-item">
              <summary class="faq-question">Wie lange ist Matcha haltbar?</summary>
              <div class="faq-answer">
                Ungeöffnet ist Matcha mehrere Monate haltbar. Nach dem Öffnen sollte er kühl, trocken und luftdicht gelagert werden.
              </div>
            </details>

            <details class="faq-item">
              <summary class="faq-question">Kann ich Matcha auch zum Backen nutzen?</summary>
              <div class="faq-answer">
                Absolut! Matcha eignet sich perfekt für Desserts, Smoothies oder kreative Backrezepte.
              </div>
            </details>
          </div>
        </div>
      </div>
    </section>

  </main>

  @include('pages/headerfooter/footer')
</body>
</html>