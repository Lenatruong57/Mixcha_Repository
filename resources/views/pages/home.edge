<!DOCTYPE html>
<html lang="de">
  <link rel="stylesheet" href="/css/home.css">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mixcha</title>
    <link rel="stylesheet" href="/css/home.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Raleway:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>

    <!-- HEADER -->
    <header class="navbar">
        <a class="logo" href="/">
          <img src="/images/logo.png" alt="Mixcha Logo">
        </a>


        <nav class="nav-links">
            <a href="/">Home</a>
            <a href="/produkte">Unsere Produkte</a>
            <a href="/blog">Blog</a>
            <a href="/login">Login</a>
            <a href="/warenkorb">Warenkorb</a>
        </nav>

        <div class="icons">
            <span>👤</span>
            <span>🔍</span>
            <span>🛒</span>
        </div>
    </header>

    <!-- HERO -->
    <section class="hero">
        <div class="hero-image"></div>

        <div class="hero-text">
            <h1>Mix your own Matcha.</h1>
            <p>Kreiere deine persönliche Mischung mit nur wenigen Klicks.</p>
            <a href="/produkte" class="btn-main">Jetzt starten</a>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="footer">
        <a href="/agb">AGB</a>
        <a href="/impressum">Impressum</a>
        <a href="/datenschutz">Datenschutz</a>
        <a href="/ueber-uns">Über uns</a>
    </footer>

</body>
</html>