<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ product.name }} – Mixcha</title>

  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/produkt_detail.css">
</head>

<body class="page">
  @include('pages/headerfooter/header')

  <main class="product-detail">
    <div class="product-detail__inner">
      <div class="product-detail__media">
        <img
          class="product-detail__img"
          src="{{ product.imageUrl ?? '/images/logo.png' }}"
          alt="{{ product.name }}"
        >
      </div>

      <section class="product-detail__content">
        <h1 class="product-detail__title">{{ product.name }}</h1>
        <p class="product-detail__text">
          Wähle deine bevorzugten Extras und erstelle deine eigene Matcha-Mischung.
        </p>

        <form class="product-detail__form" method="post" action="/warenkorb/add">
          {{ csrfField() }}

          <!-- Produktdaten -->
          <input type="hidden" name="product_id" value="{{ product.id }}">
          <input type="hidden" name="name" value="{{ product.name }}">
          <input type="hidden" name="image_url" value="{{ product.imageUrl ?? '' }}">

          <!-- wird per JS gesetzt -->
          <input type="hidden" id="unitPriceInput" name="unit_price" value="">

          <!-- Extras (aus DB) -->
          <div class="form-group">
            <label class="form-label" for="extraSelect">Extras</label>
            <select class="form-select" id="extraSelect" name="extra_id">
              @each(extra in product.extras)
                <option value="{{ extra.id }}" data-price="{{ extra.priceDelta }}">
                  {{ extra.name }}
                </option>
              @endeach
            </select>
          </div>

          <!-- Größen/Varianten (aus DB) -->
          <div class="form-group">
            <label class="form-label" for="variantSelect">Verpackungsgröße</label>
            <select class="form-select" id="variantSelect" name="variant_id">
              @each(v in product.variants)
                <option value="{{ v.id }}" data-price="{{ v.price }}">
                  {{ v.name ?? v.size ?? v.id }}
                </option>
              @endeach
            </select>
          </div>

          <!-- Preis -->
          <p class="product-detail__price">
            <span id="priceValue">0,00</span> €
          </p>

          <button class="product-detail__btn" type="submit">
            In den Warenkorb
          </button>
        </form>
      </section>
    </div>
  </main>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const variantSelect = document.getElementById("variantSelect");
      const extraSelect   = document.getElementById("extraSelect");
      const priceValue    = document.getElementById("priceValue");
      const unitPriceInput = document.getElementById("unitPriceInput");

      if (!variantSelect || !priceValue || !unitPriceInput) return;

      const fmt = (n) => Number(n).toFixed(2).replace(".", ",");

      const updatePrice = () => {
        const vOpt = variantSelect.selectedOptions[0];
        const eOpt = extraSelect ? extraSelect.selectedOptions[0] : null;

        const variantPrice = Number(vOpt?.dataset?.price || 0);
        const extraPrice = Number(eOpt?.dataset?.price || 0);

        const total = variantPrice + extraPrice;

        priceValue.textContent = fmt(total);
        unitPriceInput.value = String(total.toFixed(2));
      };

      updatePrice();
      variantSelect.addEventListener("change", updatePrice);
      if (extraSelect) extraSelect.addEventListener("change", updatePrice);
    });
  </script>

  @include('pages/headerfooter/footer')
</body>
</html>